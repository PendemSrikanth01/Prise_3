# Add this as a separate virtual host after replacing the domain.
# PRISE itself is only reachable at 127.0.0.1:3010, so DSpace ports remain untouched.
server {
    listen 80;
    server_name prise.example.org;

    client_max_body_size 25m;

    # Keep this gate until application-level authentication and RBAC are complete.
    auth_basic "PRISE internal pilot";
    auth_basic_user_file /etc/nginx/.htpasswd-prise;

    location / {
        proxy_pass http://127.0.0.1:3010;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_buffering off;
        proxy_read_timeout 60s;
    }
}
