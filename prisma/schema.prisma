// schema.prisma — PRISE 3.0 tracker
// Matches the operating model in PRISE_3_Manager_Validation_V2:
// Program -> Cohort -> Startup -> Phase -> Milestone -> Task -> Deliverable -> Review -> Progress

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// ENUMS — vocabulary lifted directly from your tracker, not invented
// ---------------------------------------------------------------------------

enum Role {
  PROGRAM_LEAD
  PROGRAM_TEAM
  INTERN
  MENTOR
  EXPERT
  INVESTOR
  FOUNDER
}

enum StartupStatus {
  APPLICATION_PENDING
  ACTIVE
  NEEDS_ATTENTION
  DISCONTINUED // "Asked to Discontinue" in your sheet
  WITHDRAWN
  GRADUATED
  REJECTED
}

enum StartupMemberRole {
  OWNER
  ADMIN
  MEMBER
  FINANCE
  VIEWER
}

enum OnboardingItemType {
  AGREEMENT
  BASELINE
  PITCH_VIDEO
  LOGO
  FEE_PAYMENT
  DOCUMENT_FOLDER
}

enum OnboardingStatus {
  PENDING // "Yet to Submit"
  SUBMITTED // "Sumitted" in source sheet
  APPROVED
  NEEDS_REVISION
  NA // startup discontinued/withdrawn — item no longer applicable
}

enum MilestoneStatus {
  NOT_STARTED
  IN_PROGRESS
  SUBMITTED
  APPROVED
  NEEDS_REVISION
  NA
  PAUSED
}

enum EffortLevel {
  LOW
  MEDIUM
  HIGH
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
  BLOCKED
}

enum AssignmentRole {
  MENTOR
  INTERN
  EXPERT
  PROGRAM_LEAD
  INVESTOR
}

enum Priority {
  HIGH
  NORMAL
  LOW
}

enum MilestoneScope {
  PROGRAM
  STARTUP
}

enum MilestoneAssignmentType {
  MANDATORY
  SELECTABLE
}

enum ReviewDecision {
  COMMENTED
  REVISION_REQUESTED
  APPROVED
}

enum SupportRequestStatus {
  OPEN
  ASSIGNED
  IN_PROGRESS
  RESOLVED
  CANCELLED
}

enum SessionType {
  MENTORING
  EXPERT
  REVIEW
  WORKSHOP
  PEER_LEARNING
  FOUNDER_SHOWCASE
  OTHER
}

enum SessionStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum AttendanceMode {
  OFFLINE
  ONLINE
  ABSENT
}

enum PaymentStatus {
  PENDING
  PAID
  OVERDUE
  WAIVED
}

enum NotificationKind {
  ACCOUNT_WELCOME
  SUPPORT_OPPORTUNITY
  SESSION_INVITE
  WEEKLY_PROGRESS
  GENERAL
}

enum NotificationStatus {
  PENDING
  SENDING
  SENT
  FAILED
  CANCELLED
}

enum DeliverableStatus {
  DRAFT
  SUBMITTED
  APPROVED
  NEEDS_REVISION
  ARCHIVED
}

enum ProgramActionLifecycle {
  DRAFT
  PLANNED
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum ProgramActionStatus {
  NOT_STARTED
  IN_PROGRESS
  WAITING
  BLOCKED
  DONE
}

enum ProgramActionCategory {
  OUTREACH
  OPERATIONS
  WORKSHOP
  MENTORING
  MASTERCLASS
  REPORTING
  STARTUP_PROGRESS
  EVENT
}

enum ProgramCoverageType {
  NONE
  AGREEMENT
  BASELINE
  PAYMENT
  MILESTONE_ASSIGNMENT
}

enum MilestoneStakeholderLane {
  STARTUP
  MENTOR
  PROGRAM
}

enum MilestoneStakeholderState {
  NOT_STARTED
  IN_PROGRESS
  SUBMITTED
  APPROVED
  NEEDS_REVISION
  BLOCKED
}

// ---------------------------------------------------------------------------
// PEOPLE
// ---------------------------------------------------------------------------

model Person {
  id                 String    @id @default(cuid())
  name               String
  email              String    @unique
  phone              String?
  role               Role
  isActive           Boolean   @default(true)
  mustChangePassword Boolean   @default(true)
  lastLoginAt        DateTime?
  passwordHash       String // Auth.js credentials provider — bcrypt hash
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  // Founder-only: the single startup this person represents
  founderOfStartupId String?  @unique
  founderOfStartup   Startup? @relation("FounderPerson", fields: [founderOfStartupId], references: [id])

  assignments             StartupAssignment[]
  startupMemberships      StartupMembership[]
  investorShares          InvestorStartupShare[]       @relation("InvestorShares")
  assignedTasks           Task[]                       @relation("TaskAssignee")
  createdTasks            Task[]                       @relation("TaskCreator")
  reviewedMilestones      Milestone[]                  @relation("MilestoneReviewer")
  uploadedDeliverables    Deliverable[]                @relation("DeliverableUploader")
  reviewedDeliverables    Deliverable[]                @relation("DeliverableReviewer")
  milestoneStatusUpdates  MilestoneStakeholderStatus[] @relation("MilestoneStatusUpdater")
  milestoneReviews        MilestoneReview[]            @relation("MilestoneReviewAuthor")
  requestedSupport        SupportRequest[]             @relation("SupportRequester")
  assignedSupport         SupportRequest[]             @relation("SupportAssignee")
  activityLogs            ActivityLog[]
  authSessions            AuthSession[]
  onboardingReviews       OnboardingItem[]             @relation("OnboardingReviewer")
  onboardingUploads       OnboardingDocument[]         @relation("OnboardingUploader")
  facilitatedSessions     Session[]                    @relation("SessionFacilitator")
  notifications           Notification[]               @relation("NotificationRecipient")
  ownedProgramActions     ProgramAction[]              @relation("ProgramActionOwner")
  createdProgramActions   ProgramAction[]              @relation("ProgramActionCreator")
  approvedProgramActions  ProgramAction[]              @relation("ProgramActionApprover")
  ownedProgramSubtasks    ProgramActionSubtask[]       @relation("ProgramSubtaskOwner")
  uploadedProgramEvidence ProgramActionEvidence[]      @relation("ProgramEvidenceUploader")
  reviewedProgramEvidence ProgramActionEvidence[]      @relation("ProgramEvidenceReviewer")
  recordedAttendance      AttendanceRecord[]           @relation("AttendanceRecorder")

  @@index([role])
  @@index([isActive])
}

model AuthSession {
  id         String    @id @default(cuid())
  tokenHash  String    @unique
  personId   String
  expiresAt  DateTime
  lastSeenAt DateTime  @default(now())
  revokedAt  DateTime?
  userAgent  String?
  createdAt  DateTime  @default(now())

  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@index([personId, revokedAt])
  @@index([expiresAt])
}

model LoginAttempt {
  id         String   @id @default(cuid())
  emailHash  String
  ipHash     String
  successful Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([emailHash, ipHash, createdAt])
  @@index([ipHash, createdAt])
  @@index([createdAt])
}

// Many-to-many: a mentor/intern/expert can support multiple startups,
// a startup can have multiple mentors/interns/experts.
model StartupAssignment {
  id        String         @id @default(cuid())
  startupId String
  personId  String
  role      AssignmentRole
  createdAt DateTime       @default(now())

  startup Startup @relation(fields: [startupId], references: [id], onDelete: Cascade)
  person  Person  @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@unique([startupId, personId, role])
  @@index([personId])
  @@index([startupId])
}

model StartupMembership {
  id        String            @id @default(cuid())
  startupId String
  personId  String
  role      StartupMemberRole @default(MEMBER)
  isActive  Boolean           @default(true)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  startup Startup @relation(fields: [startupId], references: [id], onDelete: Cascade)
  person  Person  @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@unique([startupId, personId])
  @@index([personId, isActive])
  @@index([startupId, role])
}

model InvestorStartupShare {
  id               String   @id @default(cuid())
  startupId        String
  investorId       String
  canViewDocuments Boolean  @default(false)
  sharedAt         DateTime @default(now())

  startup  Startup @relation(fields: [startupId], references: [id], onDelete: Cascade)
  investor Person  @relation("InvestorShares", fields: [investorId], references: [id], onDelete: Cascade)

  @@unique([startupId, investorId])
  @@index([investorId])
}

// ---------------------------------------------------------------------------
// STARTUP
// ---------------------------------------------------------------------------

model Startup {
  id     String @id @default(cuid())
  sNo    Int?   @unique // original S.No from the tracker, for reconciliation
  cohort String @default("PrISE 3.0")

  name              String
  founderName       String
  founderEmail      String?
  founderPhone      String?
  operationLocation String?
  state             String?
  sector            String?
  legalStructure    String?

  actualFee          Decimal? @db.Decimal(10, 2)
  agreedFee          Decimal? @db.Decimal(10, 2)
  agreedFeeRemarks   String?
  totalFeePaid       Decimal? @default(0) @db.Decimal(10, 2)
  documentFolderLink String?

  status       StartupStatus @default(ACTIVE)
  healthStatus String? // free-text next-action / health note for Home screen

  founder             Person?                @relation("FounderPerson")
  onboardingItems     OnboardingItem[]
  milestones          Milestone[]
  tasks               Task[]
  assignments         StartupAssignment[]
  memberships         StartupMembership[]
  investorShares      InvestorStartupShare[]
  supportRequests     SupportRequest[]
  sessions            Session[]
  paymentInstallments PaymentInstallment[]
  attendanceRecords   AttendanceRecord[]
  activityLogs        ActivityLog[]          @relation("StartupActivity")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

// ---------------------------------------------------------------------------
// ONBOARDING — Phase 0, the thing happening right now
// ---------------------------------------------------------------------------

model OnboardingItem {
  id           String             @id @default(cuid())
  startupId    String
  type         OnboardingItemType
  status       OnboardingStatus   @default(PENDING)
  submittedAt  DateTime?
  approvedAt   DateTime?
  reviewedById String?
  remarks      String?

  startup    Startup              @relation(fields: [startupId], references: [id], onDelete: Cascade)
  reviewedBy Person?              @relation("OnboardingReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  documents  OnboardingDocument[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([startupId, type])
  @@index([status])
  @@index([reviewedById])
}

model OnboardingDocument {
  id               String    @id @default(cuid())
  onboardingItemId String
  uploaderId       String?
  name             String
  storageKey       String
  mimeType         String?
  sizeBytes        Int?
  version          Int       @default(1)
  description      String?
  createdAt        DateTime  @default(now())
  archivedAt       DateTime?

  onboardingItem OnboardingItem @relation(fields: [onboardingItemId], references: [id], onDelete: Cascade)
  uploader       Person?        @relation("OnboardingUploader", fields: [uploaderId], references: [id], onDelete: SetNull)

  @@index([onboardingItemId, createdAt])
  @@index([uploaderId])
  @@index([archivedAt])
}

// ---------------------------------------------------------------------------
// MILESTONES — the master 52-item library, and what each startup is assigned
// ---------------------------------------------------------------------------

model MilestoneTemplate {
  id             String                  @id @default(cuid())
  phase          Int // 1-7
  phaseName      String // e.g. "Foundation & Alignment"
  title          String
  keyActivity    String
  deliverable    String
  effort         EffortLevel
  scope          MilestoneScope          @default(STARTUP)
  assignmentType MilestoneAssignmentType @default(SELECTABLE)
  isActive       Boolean                 @default(true)

  milestones Milestone[] // startups that adopted this template

  @@unique([phase, title])
  @@index([phase])
}

model Milestone {
  id         String  @id @default(cuid())
  startupId  String
  templateId String? // null = custom milestone written for this startup only

  phase       Int
  title       String
  keyActivity String?
  deliverable String?
  effort      EffortLevel @default(MEDIUM)

  status      MilestoneStatus @default(NOT_STARTED)
  dueDate     DateTime?
  submittedAt DateTime?
  approvedAt  DateTime?
  evidenceUrl String?
  reviewerId  String?
  priority    Priority        @default(NORMAL)

  startup             Startup                      @relation(fields: [startupId], references: [id], onDelete: Cascade)
  template            MilestoneTemplate?           @relation(fields: [templateId], references: [id])
  reviewer            Person?                      @relation("MilestoneReviewer", fields: [reviewerId], references: [id])
  tasks               Task[]
  deliverables        Deliverable[]
  reviews             MilestoneReview[]
  stakeholderStatuses MilestoneStakeholderStatus[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([startupId, templateId])
  @@index([startupId, status])
  @@index([phase])
  @@index([templateId])
  @@index([reviewerId])
}

// ---------------------------------------------------------------------------
// WORK — tasks, optionally linked to a milestone
// ---------------------------------------------------------------------------

model Task {
  id          String  @id @default(cuid())
  startupId   String?
  milestoneId String?
  assigneeId  String?
  createdById String?

  title         String
  description   String?
  status        TaskStatus @default(TODO)
  priority      Priority   @default(NORMAL)
  dueDate       DateTime?
  completedAt   DateTime?
  blockedReason String?

  startup   Startup?   @relation(fields: [startupId], references: [id], onDelete: Cascade)
  milestone Milestone? @relation(fields: [milestoneId], references: [id])
  assignee  Person?    @relation("TaskAssignee", fields: [assigneeId], references: [id])
  createdBy Person?    @relation("TaskCreator", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([assigneeId, status])
  @@index([createdById, createdAt])
  @@index([startupId])
  @@index([milestoneId])
}

model Deliverable {
  id              String                    @id @default(cuid())
  milestoneId     String
  uploaderId      String?
  name            String
  storageKey      String
  mimeType        String?
  sizeBytes       Int?
  version         Int                       @default(1)
  status          DeliverableStatus         @default(SUBMITTED)
  description     String?
  reviewerId      String?
  feedback        String?
  submittedAt     DateTime?                 @default(now())
  reviewedAt      DateTime?
  stakeholderLane MilestoneStakeholderLane?
  createdAt       DateTime                  @default(now())

  milestone Milestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  uploader  Person?   @relation("DeliverableUploader", fields: [uploaderId], references: [id])
  reviewer  Person?   @relation("DeliverableReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)

  @@index([milestoneId, createdAt])
  @@index([uploaderId])
  @@index([status, createdAt])
  @@index([reviewerId])
  @@index([milestoneId, stakeholderLane, createdAt])
}

// ---------------------------------------------------------------------------
// PROGRAM OPERATIONS — internal action plan, ownership, evidence and readiness
// ---------------------------------------------------------------------------

model ProgramAction {
  id           String                 @id @default(cuid())
  cohort       String                 @default("PrISE 3.0")
  phase        Int
  phaseName    String
  title        String
  position     Int
  category     ProgramActionCategory  @default(OPERATIONS)
  lifecycle    ProgramActionLifecycle @default(PLANNED)
  status       ProgramActionStatus    @default(NOT_STARTED)
  priority     Priority               @default(NORMAL)
  isMandatory  Boolean                @default(true)
  coverageType ProgramCoverageType    @default(NONE)
  startDate    DateTime?
  dueDate      DateTime?
  notes        String?
  ownerId      String?
  createdById  String?
  approvedById String?
  approvedAt   DateTime?
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt

  owner      Person?                 @relation("ProgramActionOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  createdBy  Person?                 @relation("ProgramActionCreator", fields: [createdById], references: [id], onDelete: SetNull)
  approvedBy Person?                 @relation("ProgramActionApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  subtasks   ProgramActionSubtask[]
  evidence   ProgramActionEvidence[]

  @@unique([cohort, phase, title])
  @@index([cohort, phase, position])
  @@index([lifecycle, status])
  @@index([ownerId, status, dueDate])
  @@index([dueDate, status])
}

model ProgramActionSubtask {
  id        String              @id @default(cuid())
  actionId  String
  title     String
  position  Int
  status    ProgramActionStatus @default(NOT_STARTED)
  dueDate   DateTime?
  notes     String?
  ownerId   String?
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  action   ProgramAction           @relation(fields: [actionId], references: [id], onDelete: Cascade)
  owner    Person?                 @relation("ProgramSubtaskOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  evidence ProgramActionEvidence[]

  @@unique([actionId, title])
  @@index([actionId, position])
  @@index([ownerId, status, dueDate])
}

model ProgramActionEvidence {
  id          String            @id @default(cuid())
  actionId    String
  subtaskId   String?
  uploaderId  String?
  reviewerId  String?
  name        String
  storageKey  String
  mimeType    String?
  sizeBytes   Int?
  version     Int               @default(1)
  status      DeliverableStatus @default(SUBMITTED)
  description String?
  feedback    String?
  submittedAt DateTime          @default(now())
  reviewedAt  DateTime?
  createdAt   DateTime          @default(now())

  action   ProgramAction         @relation(fields: [actionId], references: [id], onDelete: Cascade)
  subtask  ProgramActionSubtask? @relation(fields: [subtaskId], references: [id], onDelete: SetNull)
  uploader Person?               @relation("ProgramEvidenceUploader", fields: [uploaderId], references: [id], onDelete: SetNull)
  reviewer Person?               @relation("ProgramEvidenceReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)

  @@index([actionId, createdAt])
  @@index([subtaskId, createdAt])
  @@index([status, createdAt])
  @@index([uploaderId])
  @@index([reviewerId])
}

model MilestoneStakeholderStatus {
  id          String                    @id @default(cuid())
  milestoneId String
  lane        MilestoneStakeholderLane
  state       MilestoneStakeholderState @default(NOT_STARTED)
  note        String?
  updatedById String
  createdAt   DateTime                  @default(now())
  updatedAt   DateTime                  @updatedAt

  milestone Milestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  updatedBy Person    @relation("MilestoneStatusUpdater", fields: [updatedById], references: [id])

  @@unique([milestoneId, lane])
  @@index([lane, state])
  @@index([updatedById, updatedAt])
}

model MilestoneReview {
  id          String         @id @default(cuid())
  milestoneId String
  reviewerId  String
  decision    ReviewDecision
  feedback    String?
  createdAt   DateTime       @default(now())

  milestone Milestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  reviewer  Person    @relation("MilestoneReviewAuthor", fields: [reviewerId], references: [id])

  @@index([milestoneId, createdAt])
  @@index([reviewerId])
}

model SupportRequest {
  id            String               @id @default(cuid())
  startupId     String
  requestedById String?
  assignedToId  String?
  title         String
  description   String?
  resourceType  AssignmentRole?
  priority      Priority             @default(NORMAL)
  status        SupportRequestStatus @default(OPEN)
  outcome       String?
  dueDate       DateTime?
  resolvedAt    DateTime?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  startup     Startup @relation(fields: [startupId], references: [id], onDelete: Cascade)
  requestedBy Person? @relation("SupportRequester", fields: [requestedById], references: [id])
  assignedTo  Person? @relation("SupportAssignee", fields: [assignedToId], references: [id])

  @@index([startupId, status])
  @@index([assignedToId, status])
}

model Session {
  id              String        @id @default(cuid())
  startupId       String?
  facilitatorId   String?
  title           String
  description     String?
  type            SessionType
  status          SessionStatus @default(SCHEDULED)
  startsAt        DateTime
  endsAt          DateTime?
  participantIds  String[]
  isCohortWide    Boolean       @default(false)
  meetingProvider String?
  externalEventId String?       @unique
  meetingUrl      String?
  outcome         String?
  nextActions     String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  startup     Startup?           @relation(fields: [startupId], references: [id], onDelete: Cascade)
  facilitator Person?            @relation("SessionFacilitator", fields: [facilitatorId], references: [id], onDelete: SetNull)
  attendance  AttendanceRecord[]

  @@index([startsAt, status])
  @@index([startupId])
  @@index([facilitatorId, startsAt])
  @@index([participantIds], type: Gin)
}

model AttendanceRecord {
  id           String         @id @default(cuid())
  sessionId    String
  startupId    String
  mode         AttendanceMode
  note         String?
  recordedById String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  session    Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  startup    Startup @relation(fields: [startupId], references: [id], onDelete: Cascade)
  recordedBy Person? @relation("AttendanceRecorder", fields: [recordedById], references: [id], onDelete: SetNull)

  @@unique([sessionId, startupId])
  @@index([startupId, mode])
  @@index([sessionId, mode])
  @@index([recordedById, createdAt])
}

model Notification {
  id                String             @id @default(cuid())
  recipientId       String?
  recipientEmail    String
  kind              NotificationKind
  status            NotificationStatus @default(PENDING)
  subject           String
  htmlBody          String
  textBody          String?
  relatedEntityType String?
  relatedEntityId   String?
  scheduledFor      DateTime           @default(now())
  sentAt            DateTime?
  attempts          Int                @default(0)
  providerMessageId String?
  lastError         String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  recipient Person? @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: SetNull)

  @@index([status, scheduledFor])
  @@index([recipientId, createdAt])
  @@index([relatedEntityType, relatedEntityId])
}

model PaymentInstallment {
  id        String        @id @default(cuid())
  startupId String
  dueDate   DateTime
  amount    Decimal       @db.Decimal(10, 2)
  status    PaymentStatus @default(PENDING)
  paidAt    DateTime?
  reference String?
  remarks   String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  startup Startup @relation(fields: [startupId], references: [id], onDelete: Cascade)

  @@index([startupId, status])
  @@index([dueDate, status])
}

// ---------------------------------------------------------------------------
// ACTIVITY LOG — auto-written, powers the Activity tab and email triggers
// ---------------------------------------------------------------------------

model ActivityLog {
  id         String   @id @default(cuid())
  entityType String // "Startup" | "OnboardingItem" | "Milestone" | "Task"
  entityId   String
  actorId    String?
  actorRole  Role?
  startupId  String?
  action     String // e.g. "status_changed", "created", "approved"
  summary    String
  meta       Json? // { from, to, field } — free-form, keeps this table generic
  createdAt  DateTime @default(now())

  actor   Person?  @relation(fields: [actorId], references: [id])
  startup Startup? @relation("StartupActivity", fields: [startupId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([startupId, createdAt])
  @@index([actorId, createdAt])
  @@index([createdAt])
}
