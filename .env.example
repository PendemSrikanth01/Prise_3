# Copy to .env on the KVM4 server. Never commit the real file.
POSTGRES_DB=prise
POSTGRES_USER=prise
POSTGRES_PASSWORD=replace-with-a-strong-random-database-password
PRISE_PORT=3010
APP_URL=https://prise.example.org
SESSION_SECRET=replace-with-at-least-32-cryptographically-random-characters
AUTOMATION_SECRET=replace-with-at-least-32-cryptographically-random-characters

# Required only for the one-time seed command.
ADMIN_EMAIL=admin@example.org
ADMIN_INITIAL_PASSWORD=replace-with-a-unique-password-of-at-least-6-characters

# Transactional email remains off until the Resend domain is verified.
RESEND_API_KEY=
MAIL_FROM=PRISE 3.0 <notifications@mail.prise.bvcsrb.org>
MAIL_REPLY_TO=prise@balavikasa.org
EMAIL_DELIVERY_ENABLED=false
UPLOAD_DIR=/app/uploads

# Google Calendar + Meet. Create a Web OAuth client in Google Cloud.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://prise.example.org/api/google-calendar/callback
# Generate with: openssl rand -base64 32
GOOGLE_TOKEN_ENCRYPTION_KEY=
